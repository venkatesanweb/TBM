# Copy this file to .env and replace every example secret before deployment.
POSTGRES_DB=tamirabot
POSTGRES_USER=tamirabot
POSTGRES_PASSWORD=replace-with-a-long-random-password

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DOMAIN=localhost
CADDY_BIND_ADDRESS=127.0.0.1
BACKUP_HOST_DIRECTORY=./backups
BACKUP_RETENTION_COUNT=14
TAMIRABOT_APP_VERSION=0.1.0
GUNICORN_TIMEOUT=3600

# Production profile: set the real hostname and Cloudflare Tunnel token.
# Keep secrets private; never commit .env.
CLOUDFLARE_TUNNEL_TOKEN=
DJANGO_SECURE_HSTS_SECONDS=31536000
SUPER_ADMIN_TOTP_SECRETS_JSON=
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_CONNECTIONS=50

# Optional TOTP for Super Admins. Store per-username Base32 seeds privately in
# SUPER_ADMIN_TOTP_SECRETS_JSON; never commit actual seeds.
TWO_FACTOR_AUTHENTICATION_ENABLED=False
TWO_FACTOR_VERIFIER=accounts.totp.verify_super_admin_totp
