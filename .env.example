# Copy this file to .env and replace every example secret before deployment.
POSTGRES_DB=tamirabot
POSTGRES_USER=tamirabot
POSTGRES_PASSWORD=replace-with-a-long-random-password

DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DOMAIN=localhost
CADDY_BIND_ADDRESS=127.0.0.1

# Optional pluggable second-factor verifier: dotted Python path to a callable
# accepting (user, code) and returning True only when the code is valid.
TWO_FACTOR_AUTHENTICATION_ENABLED=False
TWO_FACTOR_VERIFIER=
